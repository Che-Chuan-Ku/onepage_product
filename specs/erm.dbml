// ── 五子棋對戰平台 資料模型 (erm.dbml) ──────────────────
// 由 demand_analysis 模組（Phase 02 Entity Modeling）從 features 推導
// 命名：snake_case、table 複數；審計欄位 id/created_at/updated_at/version/is_deleted
// 軟刪除約定：is_deleted = true 表邏輯刪除，查詢預設過濾
//
// Project Note: 所有持久化 table 採軟刪除（is_deleted），唯 moves / opening_stones
//   屬不可變事件流，標 exempt。

Project gomoku {
  database_type: 'PostgreSQL'
  Note: 'Gomoku online platform — soft delete via is_deleted on mutable tables'
}

// ── Enums ───────────────────────────────────────────
Enum player_type {
  REGISTERED [note: '註冊玩家']
  GUEST      [note: '訪客玩家（僅本地全功能，線上單場）']
}

Enum room_visibility {
  PUBLIC  [note: '公開房間，列入列表']
  PRIVATE [note: '私人房間，需房間碼']
}

Enum room_status {
  WAITING     [note: '等待玩家 / 等待 Ready']
  READY       [note: '雙方皆 Ready']
  IN_PROGRESS [note: '對局進行中']
  FINISHED    [note: '對局結束']
}

Enum room_member_role {
  PLAYER    [note: '對戰席（每房最多 2 席）']
  SPECTATOR [note: '觀戰席（唯讀，不參與落子/Ready）']
}

Enum game_mode {
  LOCAL  [note: '本地雙人（同裝置）']
  ONLINE [note: '線上連線']
}

Enum opening_type {
  STANDARD [note: '標準開局（無 Swap2）']
  SWAP2    [note: 'Swap2 開局']
}

Enum game_status {
  OPENING     [note: 'Swap2 開局階段']
  PLAYING     [note: '正式對局中']
  FINISHED    [note: '已結束']
}

Enum game_result {
  BLACK_WIN [note: '黑方勝']
  WHITE_WIN [note: '白方勝']
  DRAW      [note: '和局']
}

Enum stone_color {
  BLACK
  WHITE
}

Enum coin_result {
  HEADS
  TAILS
}

Enum swap2_choice {
  TAKE_BLACK        [note: '假後方執黑']
  TAKE_WHITE        [note: '假後方執白']
  PLACE_TWO_MORE    [note: '放第4·5子，再由對手選色']
}

// ── 真劍勝負模式 Enums（需求 #34–#45）───────────────────
Enum battle_mode {
  NORMAL        [note: '普通模式']
  SERIOUS_DUEL  [note: '真劍勝負模式；與 is_swap2_mode 互斥（Q9）']
}

Enum field_type {
  VOLCANO [note: '火山場地，15×15（需求 #39）']
  BEACH   [note: '沙灘場地，專用 16×16（需求 #40）']
}

Enum class_type {
  WARRIOR [note: '劍士：橫劈/縱劈/大絕天地反轉（需求 #42）']
  ARCHER  [note: '弓箭手：精準狙擊/散射/大絕開拓之星（需求 #43）']
}

Enum skill_type {
  HORIZONTAL_SLASH       [note: '橫劈，劍士一般技能']
  VERTICAL_SLASH         [note: '縱劈，劍士一般技能']
  HEAVEN_EARTH_REVERSAL  [note: '大絕：天地反轉，劍士；施法錨點(anchor)必須為空格，backend 驗證（需求 #42）']
  PRECISION_SNIPE        [note: '精準狙擊，弓箭手一般技能']
  SCATTER_SHOT           [note: '散射，弓箭手一般技能']
  PIONEER_STAR           [note: '大絕：開拓之星，弓箭手；施法錨點(anchor)必須為空格，backend 驗證（需求 #43）']
}

Enum field_cell_kind {
  OBSTACLE [note: '火山障礙物，開局生成、雙方可見、禁止落子']
  ERUPTION [note: '火山隱藏噴發格，server-only、一次性']
  TIDE     [note: '沙灘隱藏漲潮格，server-only、一次性']
}

Enum field_event_type {
  FIELD_GENERATED        [note: '對局建立時生成場地（障礙物/隱藏格/海洋沙灘分佈），move_number 為 null']
  STONE_PUSHED           [note: '推擠解算器：棋子被推移']
  STONE_REMOVED_OFF_BOARD [note: '推擠解算器：末端棋子被推出棋盤外移除']
  STONES_BURNED          [note: '火山噴發燒毀棋子（對應 feature 事件 StonesBurned，與其餘複數效果事件如 STONES_CLEARED 命名一致）']
  STONE_REPLACED         [note: '精準狙擊替換敵方棋子']
  STONES_CLEARED         [note: '開拓之星清除範圍棋子']
  COLORS_SWAPPED         [note: '天地反轉範圍顏色互換']
  VOLCANO_ERUPTED        [note: '火山噴發觸發']
  WAVE_SURGED            [note: '海浪觸發（每5輪/10手）']
  TIDE_TRIGGERED         [note: '漲潮格被踩中觸發']
  TIDE_RISEN             [note: '漲潮後海浪追加侵蝕沙灘']
  SAND_ERODED            [note: '沙灘排被侵蝕為海洋']
}

Enum board_side {
  NORTH
  SOUTH
  EAST
  WEST
}

// ── 玩家 ─────────────────────────────────────────────
Table players {
  id varchar(36) [pk]
  player_type player_type [not null]
  username varchar(50) [note: '註冊玩家登入帳號 / 顯示暱稱；訪客為暱稱']
  email varchar(255) [note: '訪客為 null']
  password_hash varchar(255) [note: '訪客為 null，不存明文']
  nickname varchar(50) [note: '訪客暱稱（非持久帳號時亦用）']

  created_at timestamp [not null]
  updated_at timestamp [not null]
  version int [not null, default: 0]
  is_deleted boolean [not null, default: false]

  Indexes {
    username [unique, name: 'uk_players_username']
    email [unique, name: 'uk_players_email']
  }
  Note: '訪客玩家以臨時實體表示，是否落庫由 backend 決定；email/password 對訪客為 null'
}

// ── 玩家戰績（需求 #3）────────────────────────────────
// 排行榜主排序鍵 = wins DESC（Q2 已定）；並列以 win_rate DESC 為次鍵。
// 上榜門檻：games_played (= wins + losses) >= 10（Q2 已定）。
Table player_stats {
  id varchar(36) [pk]
  player_id varchar(36) [not null]
  wins int [not null, default: 0]
  losses int [not null, default: 0]
  draws int [not null, default: 0, note: '和局數（雙方同時斷線判和等）']
  win_rate decimal(19,4) [not null, default: 0, note: '勝率，由 wins/(wins+losses) 推導快取']

  created_at timestamp [not null]
  updated_at timestamp [not null]
  version int [not null, default: 0]
  is_deleted boolean [not null, default: false]

  Indexes {
    player_id [unique, name: 'uk_player_stats_player_id']
    (wins, win_rate) [name: 'idx_player_stats_leaderboard', note: '排行榜主鍵 wins DESC、次鍵 win_rate DESC']
  }
  Note: '排行榜：主鍵 wins DESC、次鍵 win_rate DESC；上榜門檻 wins+losses >= 10'
}
Ref: player_stats.player_id > players.id

// ── 房間（需求 #5 #6 #7 #26）───────────────────────────
Table game_rooms {
  id varchar(36) [pk]
  room_code varchar(12) [not null, note: '房間碼']
  visibility room_visibility [not null]
  status room_status [not null, default: 'WAITING']
  is_swap2_mode boolean [not null, default: false]
  battle_mode battle_mode [not null, default: 'NORMAL', note: '普通/真劍勝負；SERIOUS_DUEL 與 is_swap2_mode=true 互斥（Q9，需求 #34）']
  field_type field_type [note: '真劍勝負場地 VOLCANO/BEACH；battle_mode=NORMAL 時為 null（需求 #34）']
  host_player_id varchar(36) [not null]
  guest_player_id varchar(36) [note: '第二位對戰玩家，未加入前為 null（對戰席上限 2）']

  created_at timestamp [not null]
  updated_at timestamp [not null]
  version int [not null, default: 0]
  is_deleted boolean [not null, default: false]

  Indexes {
    room_code [unique, name: 'uk_game_rooms_room_code']
    (visibility, status) [name: 'idx_game_rooms_visibility_status']
  }
}
Ref: game_rooms.host_player_id > players.id
Ref: game_rooms.guest_player_id > players.id

// ── 房間成員 Ready 狀態 + 角色（需求 #7、Q5 觀戰）──────
// role=PLAYER：對戰席，每房最多 2 席；role=SPECTATOR：觀戰席（唯讀，is_ready 恆 false）。
Table room_members {
  id varchar(36) [pk]
  room_id varchar(36) [not null]
  player_id varchar(36) [not null]
  role room_member_role [not null, default: 'PLAYER', note: 'PLAYER=對戰席（上限2） / SPECTATOR=觀戰席']
  is_ready boolean [not null, default: false, note: '觀戰席恆 false，不參與 Ready 判定']
  class_type class_type [note: '真劍勝負模式職業選擇；可同職業；Ready 前可改，Ready 即鎖定（需求 #35）']

  created_at timestamp [not null]
  updated_at timestamp [not null]
  version int [not null, default: 0]
  is_deleted boolean [not null, default: false]

  Indexes {
    (room_id, player_id) [unique, name: 'uk_room_members_room_player']
    (room_id, role) [name: 'idx_room_members_room_role', note: '依房間統計對戰席/觀戰席人數']
  }
  Note: '對戰席（role=PLAYER）每房至多 2 筆；其餘為 SPECTATOR 觀戰席'
}
Ref: room_members.room_id > game_rooms.id
Ref: room_members.player_id > players.id

// ── 聊天訊息（需求 #7，MVP 後加）───────────────────────
Table room_chat_messages {
  id varchar(36) [pk]
  room_id varchar(36) [not null]
  player_id varchar(36) [not null]
  content varchar(500) [not null]

  created_at timestamp [not null]
  updated_at timestamp [not null]
  version int [not null, default: 0]
  is_deleted boolean [not null, default: false]

  Indexes {
    room_id [name: 'idx_room_chat_messages_room_id']
  }
}
Ref: room_chat_messages.room_id > game_rooms.id
Ref: room_chat_messages.player_id > players.id

// ── 對局（需求 #8~#13 #24 #30）─────────────────────────
Table games {
  id varchar(36) [pk]
  room_id varchar(36) [note: '本地對局可為 null']
  game_mode game_mode [not null]
  opening_type opening_type [not null, default: 'STANDARD']
  use_swap2 boolean [not null, default: false]
  battle_mode battle_mode [not null, default: 'NORMAL', note: '建局時由房間快照；SERIOUS_DUEL 與 use_swap2=true 互斥（需求 #34）']
  field_type field_type [note: '建局時由房間快照，僅 battle_mode=SERIOUS_DUEL 使用（需求 #34）']
  status game_status [not null, default: 'PLAYING']

  black_player_id varchar(36) [note: '顏色定案後填入；Swap2 開局期間可為 null']
  white_player_id varchar(36)
  tentative_first_player_id varchar(36) [note: 'Swap2 假先方']
  black_class class_type [note: '真劍勝負：揭曉時機＝status 轉為 PLAYING（ClassesRevealed 觸發點；真劍勝負 opening_type=STANDARD 無 Swap2 開局，建局即為 PLAYING）（需求 #35）']
  white_class class_type [note: '真劍勝負：揭曉時機＝status 轉為 PLAYING（同 black_class，需求 #35）']

  coin_result coin_result [note: '硬幣結果（後端決定）']
  current_turn stone_color [note: '當前輪到的顏色']

  result game_result [note: '結束時填入']
  winner_player_id varchar(36) [note: '和局為 null']
  move_count int [not null, default: 0]
  duration_seconds int [note: '對局耗時']
  ended_at timestamp

  created_at timestamp [not null]
  updated_at timestamp [not null]
  version int [not null, default: 0]
  is_deleted boolean [not null, default: false]

  Indexes {
    room_id [name: 'idx_games_room_id']
    winner_player_id [name: 'idx_games_winner_player_id']
  }
}
Ref: games.room_id > game_rooms.id
Ref: games.black_player_id > players.id
Ref: games.white_player_id > players.id
Ref: games.tentative_first_player_id > players.id
Ref: games.winner_player_id > players.id

// ── 落子序列（需求 #11 #16 #17 #32）────────────────────
// 不可變事件流，免審計欄位
Table moves {
  id varchar(36) [pk]
  game_id varchar(36) [not null]
  move_number int [not null, note: '落子序號，從 1 起；開局子見 opening_stones']
  color stone_color [not null]
  row int [not null, note: '0..14（一般/火山 15×15）；真劍勝負沙灘場地為 0..15（16×16，需求 #40）']
  col int [not null, note: '0..14（一般/火山 15×15）；真劍勝負沙灘場地為 0..15（16×16，需求 #40）']
  placed_at timestamp [not null]

  Indexes {
    (game_id, move_number) [unique, name: 'uk_moves_game_move_number']
    (game_id, row, col) [unique, name: 'uk_moves_game_position', note: '僅適用一般模式；真劍勝負模式因燒毀/推走格可再下，該唯一約束不成立（backend V2 已 DROP，佔位格檢查改由 service 層執行）']
  }
  Note: '[exempt: created_at/updated_at/version/is_deleted, reason: 不可變對局事件流]'
}
Ref: moves.game_id > games.id

// ── 開局子（Swap2，需求 #24 #28 #31 #32）───────────────
// 獨立記錄開局 stones，支援悔最後一子與回放
Table opening_stones {
  id varchar(36) [pk]
  game_id varchar(36) [not null]
  sequence int [not null, note: '開局放置順序，從 1 起']
  color stone_color [not null]
  row int [not null]
  col int [not null]
  placed_by_player_id varchar(36) [not null]
  placed_at timestamp [not null]

  Indexes {
    (game_id, sequence) [unique, name: 'uk_opening_stones_game_sequence']
  }
  Note: '[exempt: updated_at/version, reason: 開局事件流；可被「悔最後一子」物理移除]'
}
Ref: opening_stones.game_id > games.id
Ref: opening_stones.placed_by_player_id > players.id

// ── 真劍勝負：技能使用紀錄（需求 #36 #42 #43）──────────
// 不可變事件流，免審計欄位；每技能每局每玩家僅能使用一次
Table skill_usages {
  id varchar(36) [pk]
  game_id varchar(36) [not null]
  player_id varchar(36) [not null]
  skill_type skill_type [not null]
  move_number int [note: '觸發該技能的落子/施法序號']
  used_at timestamp [not null]

  Indexes {
    (game_id, player_id, skill_type) [unique, name: 'uk_skill_usages_game_player_skill']
  }
  Note: '[exempt: created_at/updated_at/version/is_deleted, reason: 不可變技能使用事件流]'
}
Ref: skill_usages.game_id > games.id
Ref: skill_usages.player_id > players.id

// ── 真劍勝負：場地格資訊（需求 #39 #40 #44）─────────────
// 障礙物（OBSTACLE）開局即可見；噴發/漲潮格（ERUPTION/TIDE）server-only、觸發後才可見
Table field_cells {
  id varchar(36) [pk]
  game_id varchar(36) [not null]
  cell_kind field_cell_kind [not null]
  row int [not null]
  col int [not null]
  visible_to_players boolean [not null, default: false, note: 'OBSTACLE 預設 true；ERUPTION/TIDE 觸發前為 false']
  triggered boolean [not null, default: false, note: 'ERUPTION/TIDE 一次性；觸發後轉為普通格']
  triggered_at timestamp

  created_at timestamp [not null]
  updated_at timestamp [not null]
  version int [not null, default: 0]
  is_deleted boolean [not null, default: false]

  Indexes {
    (game_id, row, col) [unique, name: 'uk_field_cells_game_position']
    (game_id, cell_kind) [name: 'idx_field_cells_game_kind']
  }
}
Ref: field_cells.game_id > games.id

// ── 真劍勝負：場地整體狀態（需求 #40 #41 #46）───────────
// 每局一列；沙灘侵蝕進度與海浪回合計數，用於斷線重連恢復
Table field_states {
  id varchar(36) [pk]
  game_id varchar(36) [not null]
  field_type field_type [not null]
  sea_side board_side [note: '沙灘限定：海洋起始側，隨機決定']
  eroded_rows int [not null, default: 0, note: '沙灘已侵蝕排數，漸進直到全海洋']
  tide_triggered boolean [not null, default: false]
  round_counter int [not null, default: 0, note: '雙方各下一手為1輪，累積滿5輪(10手)觸發海浪後歸零']

  created_at timestamp [not null]
  updated_at timestamp [not null]
  version int [not null, default: 0]
  is_deleted boolean [not null, default: false]

  Indexes {
    game_id [unique, name: 'uk_field_states_game_id']
  }
}
Ref: field_states.game_id > games.id

// ── 真劍勝負：技能／場地效果事件流（需求 #37 #38 #47）───
// 不可變事件流；供結算重現與回放（含隱藏格觸發時點），免審計欄位
Table field_events {
  id varchar(36) [pk]
  game_id varchar(36) [not null]
  move_number int [note: '對應觸發此效果的落子/施法序號；FIELD_GENERATED 於建局時發生，move_number 為 null']
  event_type field_event_type [not null]
  row int
  col int
  detail varchar [note: 'JSON：如推擠方向、互換前後顏色、清除/替換座標清單等']
  occurred_at timestamp [not null]

  Indexes {
    (game_id, move_number) [name: 'idx_field_events_game_move']
  }
  Note: '[exempt: created_at/updated_at/version/is_deleted, reason: 不可變場地/技能事件流，供回放重現]'
}
Ref: field_events.game_id > games.id

// ══════════════════════════════════════════════════════════════
// ── PVE 挑戰模式增量（documents/PVE-挑戰模式-增量需求.md）───────
// 增量 A（效果資料驅動化）/ B（單關挑戰）/ C（Run 循環）共用區段
// ══════════════════════════════════════════════════════════════

// ── 增量 A：效果系統資料驅動化 Enums（FR-A1 FR-A2）────────────
Enum battle_context {
  PVP [note: '真劍勝負模式；一般技能=ATTACHED_TO_MOVE、大絕=REPLACE_MOVE，皆 ONCE_PER_GAME']
  PVE [note: '挑戰模式；全部技能=INDEPENDENT，皆 CONSUMABLE（FR-A2）']
}

Enum effect_action_type {
  ATTACHED_TO_MOVE [note: '附加於落子，與落子同手結算']
  REPLACE_MOVE     [note: '取代落子，施放本身即為該手行動']
  INDEPENDENT      [note: '獨立行動：不落子、不消耗手數（PVE 專用，FR-A2/FR-B5）']
}

Enum effect_usage_limit_type {
  ONCE_PER_GAME [note: '每場對局每玩家至多使用一次（PVP 現況）']
  CONSUMABLE    [note: '消耗型：使用一次即從持有中移除（PVE 專用）']
  CHARGE        [note: '充能型：保留擴充，本增量未使用']
}

// ── 增量 A：效果定義表（FR-A1 FR-A2 FR-A3）────────────────────
// 同一 effect_key（對應現有 skill_type 或 field_event_type 列舉值）依 battle_context
// 各自宣告 action_type / usage_limit_type，藉此让 PVP／PVE 使用同一效果卻有不同行為型態，
// 不寫死於程式碼。引擎僅實作 ops 值域內的原子操作：PLACE(落子)/REMOVE(移除)/PUSH(推移)/
// TRANSFORM(變換,如顏色互換)/GENERATE(生成)/MODIFY_VALUE(數值修飾,如傷害倍率)。
// 實作型態（DB 表 or 靜態 JSON 設定檔）由工程階段擇一，本表定義其邏輯結構供對照。
Table effect_definitions {
  id varchar(36) [pk]
  effect_key varchar(50) [not null, note: '對應 skill_type 或 field_event_type 列舉值（如 HORIZONTAL_SLASH、VOLCANO_ERUPTED）']
  applicable_mode battle_context [not null]
  action_type effect_action_type [not null]
  usage_limit_type effect_usage_limit_type [not null]
  trigger varchar(100) [not null, note: '觸發時機，如 on_move_placed / on_move_interval / on_line_resolved']
  condition varchar [note: 'JSON：觸發條件（如錨點需為空格、目標需為現存敵方棋子）']
  ops varchar [not null, note: 'JSON 陣列：原子操作序列，值域見上方 ops 說明']
  params varchar [note: 'JSON：數值參數（推擠距離、範圍、倍率、傷害基礎值等）']

  created_at timestamp [not null]
  updated_at timestamp [not null]
  version int [not null, default: 0]
  is_deleted boolean [not null, default: false]

  Indexes {
    (effect_key, applicable_mode) [unique, name: 'uk_effect_definitions_key_mode']
  }
  Note: 'FR-A1/A2：現有 6 技能 + 2 場地效果（VOLCANO_ERUPTED/WAVE_SURGED 等）皆須有對應列；PVP 行為不變（回歸驗證基準）'
}

// ── 增量 B/C：PVE Enums ────────────────────────────────────────
Enum pve_run_status {
  IN_PROGRESS [note: '進行中']
  WON         [note: '通過第 8 關']
  LOST        [note: '任一關手數用盡、Boss HP 未歸零']
  ABANDONED   [note: '玩家主動放棄（視同失敗，FR-C7）']
}

Enum pve_encounter_status {
  IN_PROGRESS
  CLEARED [note: 'Boss HP <= 0，立即結束（FR-B4）']
  FAILED  [note: '手數用盡且 Boss HP > 0（FR-B4）']
}

Enum pve_field_type {
  PLAIN   [note: '無場地效果，11×11（FR-B1，第1/3/4/6/8關）']
  VOLCANO [note: 'PVE 專用 11×11 變體；與真劍勝負 field_type(VOLCANO=15×15) 為新幾何規格，不共用棋盤尺寸（FR-C2 工程註記）']
  BEACH   [note: 'PVE 專用 11×11 變體；海側 5 行、沙側 6 行（⌊11/2⌋=5，FR-C2）；與真劍勝負 BEACH(16×16) 不共用棋盤尺寸']
}

Enum pve_mutation_type {
  NONE     [note: '第 1/2/4/5/7 關無突變']
  ONE_EYE  [note: '第 3 關「獨眼」：橫向連線不結算（FR-C6）']
  RAGE     [note: '第 6 關「震怒」：每落 5 手隨機噴發清除一格+周圍8格（FR-C6）']
  ABYSS    [note: '第 8 關「深淵」：每次連線結算後隨機空格生成 1 顆障礙棋子（FR-C6）']
}

Enum pve_relic_type {
  SHARP_BLADE       [note: '銳刃：連線基礎分 +20（售價8）']
  CHAIN_CORE        [note: '連鎖核心：技能推移連鎖距離 +1 格（售價6）']
  DIAGONAL_WALKER   [note: '斜行者：斜向連線倍率 +0.5（售價10）']
  VOLCANO_HEART     [note: '火山之心：噴發清除的棋子每顆對 Boss 造成10傷害（售價10）']
  TIDE_BREAKWATER   [note: '防潮堤：海浪/漲潮不移動不移除玩家棋子（售價8）']
  METRONOME         [note: '節拍器：落子計數 Run 全程累計，每逢累計第5倍數手倍率+0.1永久生效（售價12）']
  RECYCLER          [note: '回收商：因連線移除的棋子累計每10顆，手數預算+1（當關生效，售價10）']
  GEMINI_STAR       [note: '雙子星：一手同時完成>=2條線時，該手總傷害x2（售價14）']
}

Enum pve_shop_offer_kind {
  RELIC
  SKILL
}

Enum pve_shop_visit_status {
  OPEN   [note: '尚未結束（可購買/重抽/跳過）']
  CLOSED [note: '已跳過或已結束，玩家進入下一關']
}

Enum pve_encounter_event_type {
  LINE_RESOLVED           [note: '連線結算：一手最多4方向同時各自結算，detail 含線長/方向/傷害/倍率breakdown（FR-B2 FR-B3）']
  SKILL_USED              [note: 'PVE 技能使用，move_number=使用當下已完成落子數（間隔序號，FR-B5）']
  STONES_PUSHED
  STONE_REMOVED_OFF_BOARD
  VOLCANO_ERUPTED
  WAVE_SURGED
  TIDE_TRIGGERED
  BOSS_MUTATION_TRIGGERED [note: '震怒噴發 / 深淵生成障礙棋子（FR-C6）']
  ENCOUNTER_CLEARED
  ENCOUNTER_FAILED
}

// ── 增量 C：一輪 Run（FR-C1 FR-C3 FR-C7 FR-C8）─────────────────
Table pve_runs {
  id varchar(36) [pk]
  player_id varchar(36) [not null, note: 'PVE 僅限已登入玩家（documents/PVE-挑戰模式-增量需求.md §4.2）']
  class_type class_type [not null, note: '沿用既有 WARRIOR/ARCHER 列舉（FR-B1）']
  status pve_run_status [not null, default: 'IN_PROGRESS']
  seed varchar(64) [not null, note: 'FR-A3：同 seed+同操作序列必得同結果；場地生成與各關隨機效果皆衍生自此']
  gold int [not null, default: 0, note: 'Run 內貨幣，不設上限，Run 結束歸零不跨局（FR-C3）']
  current_encounter_sequence int [not null, default: 1, note: '目前所在關次，1..8']
  reached_encounter_sequence int [not null, default: 0, note: '已通過的最高關次，供 Run 結算「到達關數」顯示（FR-C7）']
  total_damage_dealt bigint [not null, default: 0, note: '全 Run 累計傷害（FR-C7 結算顯示）']
  metronome_multiplier_bonus decimal(6,2) [not null, default: 0, note: '節拍器持有時的永久倍率加成累計；未持有節拍器時恆為0（FR-C5 #6）']
  ended_at timestamp [note: '通關/失敗/放棄時填入']

  created_at timestamp [not null]
  updated_at timestamp [not null]
  version int [not null, default: 0]
  is_deleted boolean [not null, default: false]

  Indexes {
    (player_id, status) [name: 'idx_pve_runs_player_status', note: '應用層保證同一 player_id 至多 1 筆 status=IN_PROGRESS（FR-C8），DBML 無法表示部分唯一索引，改由 service 層檢查']
  }
}
Ref: pve_runs.player_id > players.id

// ── 增量 B/C：關卡（FR-B1 FR-C1 FR-C2）─────────────────────────
Table pve_encounters {
  id varchar(36) [pk]
  run_id varchar(36) [not null]
  sequence int [not null, note: '1..8，固定順序（FR-C1）；增量B單關挑戰時 run 僅含 1 筆']
  field_type pve_field_type [not null]
  mutation_type pve_mutation_type [not null, default: 'NONE', note: '固定綁定第3/6/8關，不隨機（FR-C6）']
  board_rows int [not null, default: 11]
  board_cols int [not null, default: 11]
  boss_hp_max int [not null, note: '依 1.6 倍曲線：100/160/260/420/670/1070/1710/2740（FR-C1）；增量B單關固定100']
  boss_hp_current int [not null]
  move_budget int [not null, default: 30]
  moves_used int [not null, default: 0]
  status pve_encounter_status [not null, default: 'IN_PROGRESS']
  cleared_at timestamp
  failed_at timestamp

  created_at timestamp [not null]
  updated_at timestamp [not null]
  version int [not null, default: 0]
  is_deleted boolean [not null, default: false]

  Indexes {
    (run_id, sequence) [unique, name: 'uk_pve_encounters_run_sequence']
  }
}
Ref: pve_encounters.run_id > pve_runs.id

// ── 增量 B：關卡落子序列（FR-B2 FR-B6）─────────────────────────
// 不可變事件流，免審計欄位（同 moves 慣例）
Table pve_encounter_moves {
  id varchar(36) [pk]
  encounter_id varchar(36) [not null]
  encounter_move_number int [not null, note: '本關第幾手，1..30（對照 move_budget）']
  run_move_number int [not null, note: 'Run 全程累計手數，跨關不重置；節拍器倍率計算依此（FR-C5 #6）']
  row int [not null]
  col int [not null]
  placed_at timestamp [not null]

  Indexes {
    (encounter_id, encounter_move_number) [unique, name: 'uk_pve_encounter_moves_encounter_seq']
  }
  Note: '[exempt: created_at/updated_at/version/is_deleted, reason: 不可變關卡落子事件流]'
}
Ref: pve_encounter_moves.encounter_id > pve_encounters.id

// ── 增量 B/C：關卡場地格（沿用 field_cell_kind／board_side 列舉，FR-C2）─
Table pve_field_cells {
  id varchar(36) [pk]
  encounter_id varchar(36) [not null]
  cell_kind field_cell_kind [not null, note: 'OBSTACLE 開局即可見；ERUPTION/TIDE server-only 直到觸發（同 PVP 慣例）']
  row int [not null]
  col int [not null]
  visible_to_player boolean [not null, default: false]
  triggered boolean [not null, default: false]
  triggered_at timestamp

  created_at timestamp [not null]
  updated_at timestamp [not null]
  version int [not null, default: 0]
  is_deleted boolean [not null, default: false]

  Indexes {
    (encounter_id, row, col) [unique, name: 'uk_pve_field_cells_encounter_position']
  }
  Note: 'VOLCANO：可見障礙格3–5個、隱藏噴發格至多3個；ABYSS突變動態生成的障礙棋子亦記錄於此（FR-C2 FR-C6）'
}
Ref: pve_field_cells.encounter_id > pve_encounters.id

Table pve_field_states {
  id varchar(36) [pk]
  encounter_id varchar(36) [not null]
  sea_side board_side [note: 'BEACH限定：海側起始方向，由 seed 決定']
  eroded_rows int [not null, default: 0]
  tide_triggered boolean [not null, default: false]
  wave_move_counter int [not null, default: 0, note: '累計落子手數，滿10手觸發一次海浪後歸零（PVE 單人以落子數計，非雙方輪次，FR-C2）']

  created_at timestamp [not null]
  updated_at timestamp [not null]
  version int [not null, default: 0]
  is_deleted boolean [not null, default: false]

  Indexes {
    encounter_id [unique, name: 'uk_pve_field_states_encounter_id']
  }
}
Ref: pve_field_states.encounter_id > pve_encounters.id

// ── 增量 B/C：關卡技能／場地事件流（FR-B2 FR-B3 FR-B5 FR-C6）───
// 不可變事件流，供結算重現與續玩恢復（FR-B6），免審計欄位
Table pve_encounter_events {
  id varchar(36) [pk]
  encounter_id varchar(36) [not null]
  move_number int [note: '對應觸發之落子序號；SKILL_USED 時為使用當下已完成落子數（間隔序號，FR-B5）']
  event_type pve_encounter_event_type [not null]
  row int
  col int
  detail varchar [note: 'JSON：連線座標清單/線長/方向/基礎分/倍率breakdown/推擠方向/生成座標等']
  occurred_at timestamp [not null]

  Indexes {
    (encounter_id, move_number) [name: 'idx_pve_encounter_events_encounter_move']
  }
  Note: '[exempt: created_at/updated_at/version/is_deleted, reason: 不可變事件流，供回放與續玩重建]'
}
Ref: pve_encounter_events.encounter_id > pve_encounters.id

// ── 增量 C：Run 持有技能／遺物（FR-C4 FR-C5）───────────────────
Table pve_run_skills {
  id varchar(36) [pk]
  run_id varchar(36) [not null]
  skill_type skill_type [not null, note: '僅限玩家職業對應3技能池（WARRIOR/ARCHER各3種，FR-C4）；建立Run時依職業附贈1個（FR-B5）']
  quantity int [not null, default: 1, note: '同名技能可重複持有；使用時遞減，歸零即視為不再持有（FR-C4）']

  created_at timestamp [not null]
  updated_at timestamp [not null]
  version int [not null, default: 0]
  is_deleted boolean [not null, default: false]

  Indexes {
    (run_id, skill_type) [unique, name: 'uk_pve_run_skills_run_skill']
  }
  Note: '應用層保證同一 run 的 quantity 加總 <= 3（持有上限，FR-C4）'
}
Ref: pve_run_skills.run_id > pve_runs.id

Table pve_run_relics {
  id varchar(36) [pk]
  run_id varchar(36) [not null]
  relic_type pve_relic_type [not null]
  acquired_at timestamp [not null]

  created_at timestamp [not null]
  updated_at timestamp [not null]
  version int [not null, default: 0]
  is_deleted boolean [not null, default: false]

  Indexes {
    (run_id, relic_type) [unique, name: 'uk_pve_run_relics_run_relic', note: '已持有遺物不會被抽出、亦不可重複持有（FR-C4）']
  }
  Note: '應用層保證同一 run 至多持有 5 件遺物（持有上限，FR-C4）'
}
Ref: pve_run_relics.run_id > pve_runs.id

// ── 增量 C：商店（FR-C4）───────────────────────────────────────
Table pve_shop_visits {
  id varchar(36) [pk]
  run_id varchar(36) [not null]
  after_encounter_sequence int [not null, note: '第幾關通過後開啟；第8關通關後不開商店（FR-C4）']
  status pve_shop_visit_status [not null, default: 'OPEN']
  reroll_count int [not null, default: 0, note: '重抽次數不限，僅受金幣限制，每次5金幣（FR-C4）']
  opened_at timestamp [not null]
  closed_at timestamp

  created_at timestamp [not null]
  updated_at timestamp [not null]
  version int [not null, default: 0]
  is_deleted boolean [not null, default: false]

  Indexes {
    (run_id, after_encounter_sequence) [unique, name: 'uk_pve_shop_visits_run_sequence']
  }
}
Ref: pve_shop_visits.run_id > pve_runs.id

Table pve_shop_offer_slots {
  id varchar(36) [pk]
  shop_visit_id varchar(36) [not null]
  slot_index int [not null, note: '0,1=遺物展示位；2=技能展示位（固定遺物x2、技能x1，FR-C4）']
  offer_kind pve_shop_offer_kind [not null]
  relic_type pve_relic_type [note: 'offer_kind=RELIC 時必填；已持有遺物不會被抽出']
  skill_type skill_type [note: 'offer_kind=SKILL 時必填；僅自玩家職業3技能池抽取']
  price int [not null, note: '技能售價固定6；遺物售價見 pve_relic_type 附註（FR-C4 FR-C5）']
  purchased boolean [not null, default: false]

  created_at timestamp [not null]
  updated_at timestamp [not null]
  version int [not null, default: 0]
  is_deleted boolean [not null, default: false]

  Indexes {
    (shop_visit_id, slot_index) [unique, name: 'uk_pve_shop_offer_slots_visit_slot']
  }
}
Ref: pve_shop_offer_slots.shop_visit_id > pve_shop_visits.id
